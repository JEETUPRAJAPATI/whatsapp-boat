# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# Password special characters MUST be percent-encoded: # -> %23, $ -> %24, , -> %2C
# DATABASE_URL uses the transaction pooler (6543) for the app at runtime.
# DIRECT_URL uses the session pooler (5432) and is only used by prisma migrate.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Credential encryption
# 32-byte hex key used to AES-256-GCM encrypt Meta credentials (access token,
# app secret) before they are stored in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# Never commit a real access token. Never send it to the browser.
# These values only seed the meta_whatsapp_settings DB row on first boot -
# after that, edit them from the settings screen instead of this file.
# ---------------------------------------------------------------------------
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=914098718459659
META_WHATSAPP_BUSINESS_ACCOUNT_ID=1936192610625973
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_VERIFY_TOKEN=change_this_to_a_secure_random_value
# App Secret from Meta > App Settings > Basic. Enables X-Hub-Signature-256 checks.
META_APP_SECRET=

# Store raw webhook payloads in the webhook_logs table (dev debugging aid).
WEBHOOK_LOGGING=true
