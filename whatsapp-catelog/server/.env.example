# ===========================================================================
# WhatsApp Business Catalog Management System
# Copy to .env and fill in. NEVER commit .env - it is in .gitignore.
# Nothing in this file is ever sent to the browser.
# ===========================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4100
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5174

# Public HTTPS base URL of THIS server. Two things need it:
#   1. Meta must be able to fetch product images from it (image_url must be a
#      public URL - Meta's crawler cannot reach localhost).
#   2. It is the base of your webhook callback URL.
# In local development put your tunnel URL here (ngrok / cloudflared).
APP_PUBLIC_URL=http://localhost:4100

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# Password special characters MUST be percent-encoded: # -> %23, $ -> %24, , -> %2C
# DATABASE_URL uses the transaction pooler (6543) for the app at runtime.
# DIRECT_URL uses the session pooler (5432) and is only used by prisma migrate.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Meta app (developers.facebook.com > your app > Settings > Basic)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration id: App > WhatsApp > Configuration > Login flow.
META_CONFIG_ID=
META_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Webhook verify token - any random string; must match the value you type into
# Meta > App > WhatsApp > Configuration > Webhook.
META_WEBHOOK_VERIFY_TOKEN=change_this_to_a_secure_random_value

# ---------------------------------------------------------------------------
# Fallback / bootstrap credentials
#
# Preferred path: connect accounts through Embedded Signup at /whatsapp/setup.
# Tokens obtained that way are encrypted per-WABA in the database and these
# variables are not used.
#
# If you already run a WhatsApp number (System User token from Business
# Settings), fill these in and the server seeds that account on first boot so
# you can manage its catalog immediately.
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_CATALOG_ID=
META_BUSINESS_NAME=My Business

# ---------------------------------------------------------------------------
# Encryption at rest for Meta access tokens stored in the database.
# Must be 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes every stored token unreadable - accounts must reconnect.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=../uploads
MAX_IMAGE_MB=8
MAX_VIDEO_MB=64

# ---------------------------------------------------------------------------
# Automation
# ---------------------------------------------------------------------------
# Standard 6-field cron. Default: every day at 02:30 server time.
CATALOG_SYNC_ENABLED=true
CATALOG_SYNC_CRON=0 30 2 * * *

# Reply automatically when an incoming message matches an auto-reply rule
# (rules are managed in the admin panel, not here).
AUTO_REPLY_ENABLED=true

# Store raw webhook payloads in webhook_logs (dev debugging aid).
WEBHOOK_LOGGING=true
