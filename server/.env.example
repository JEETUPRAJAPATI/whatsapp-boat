PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_boat
# Leave blank to use the Chromium bundled with puppeteer
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
WA_HEADLESS=true

# Accounts are added from the UI, not from here - each linked number gets its own
# generated session id, its own Chrome profile under .wwebjs_auth/, and its own
# media cache. Every linked account is restored automatically on restart.

# WhatsApp Web version pinning.
# whatsapp-web.js drives the real WhatsApp Web app, so a WhatsApp release can
# break it (chats fail to load, injection dies after a page reload). Uncomment
# to serve a known build from the version archive instead of today's live one.
# Browse builds: https://github.com/wppconnect-team/wa-version/tree/main/html
# WA_WEB_VERSION=2.3000.1042605412-alpha
